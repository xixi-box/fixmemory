{
  "name": "fixmemory",
  "version": "0.2.0",
  "description": "Local-first, verified debugging memory for AI coding agents.",
  "type": "module",
  "bin": {
    "fixmemory": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "runtime",
    "skill",
    "README.md",
    "README.zh-CN.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json && node scripts/build-runtime.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm pack --dry-run"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "author": "wangshun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xixi-box/fixmemory.git"
  },
  "homepage": "https://github.com/xixi-box/fixmemory#readme",
  "bugs": {
    "url": "https://github.com/xixi-box/fixmemory/issues"
  },
  "keywords": [
    "agent",
    "debugging",
    "mcp",
    "memory",
    "local-first",
    "coding-agent"
  ],
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^24.10.1",
    "esbuild": "^0.25.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
